@model List<Smth.Data.Survey>
@{
    ViewBag.Title = "Опросы пользователя";
}

<!-- Стили (полностью скопированы из страницы «Мои опросы») -->
<style>
    :root{
        --primary:#00BFA5; --secondary:#009688; --background:#1d1d1d;
        --card-bg:#2c2c2c; --text:#fff; --text-light:#BDBDBD;
        --border-color:rgba(255,255,255,.1);
    }

    .main-container{max-width:1200px;margin:auto;padding:2rem;animation:fadeIn .6s ease}
    .page-title{font-size:2.5rem;color:var(--primary);text-align:center;margin-bottom:2rem;font-weight:700}

    .surveys-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.5rem;margin-top:2rem}

    .survey-card{
        background:var(--card-bg);border-radius:12px;padding:1.5rem;position:relative;
        box-shadow:0 4px 6px rgba(0,0,0,.05);transition:.3s
    }
    .survey-card:hover{transform:translateY(-5px) rotateZ(.5deg);box-shadow:0 8px 12px rgba(0,0,0,.1)}

    .survey-card::before{
        content:'';position:absolute;top:0;left:0;width:100%;height:4px;
        background:linear-gradient(90deg,var(--primary),var(--secondary));
    }

    .survey-title{font-size:1.3rem;font-weight:600;color:var(--text);margin-bottom:.5rem}
    .survey-description{
        color:var(--text-light);line-height:1.7;display:-webkit-box;-webkit-line-clamp:3;
        -webkit-box-orient:vertical;overflow:hidden
    }

    .survey-actions{display:flex;gap:1rem;justify-content:flex-end;margin-top:1rem}

    .btn{border-radius:8px;padding:.8rem 1.5rem;font-weight:500;transition:.3s}
    .btn-primary{background:var(--primary);color:#fff!important;text-decoration:none}
    .btn-primary:hover{transform:translateY(-2px);box-shadow:0 4px 8px rgba(0,0,0,.15)}

    .empty-state{
        text-align:center;padding:4rem;margin-top:2rem;background:rgba(255,255,255,.05);
        border-radius:12px;color:var(--text-light)
    }

    @@keyframes fadeIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

    @@media(max-width:768px){
        .surveys-grid{grid-template-columns:1fr}
        .survey-card{margin:0 1rem}
    }
</style>

<div class="main-container">
    <h1 class="page-title">
        Опросы пользователя «@ViewBag.UserName»
    </h1>

    <div class="surveys-grid">
        @foreach (var survey in Model)
        {
            <div class="survey-card">
                <h3 class="survey-title">@survey.Name</h3>
                <p class="survey-description">@(survey.Description ?? "Описание отсутствует")</p>

                <div class="survey-actions">
                    <a href="/Surveys/Details/@survey.Id" class="btn btn-primary">
                        <i class="fas fa-eye"></i> Подробнее
                    </a>
                    <a href="/Surveys/EditContent/@survey.Id" class="btn btn-primary">
                        <i class="fas fa-pen"></i> Редактировать
                    </a>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-clipboard-list fa-3x"></i>
            <p>У пользователя пока нет опросов</p>
        </div>
    }
</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
