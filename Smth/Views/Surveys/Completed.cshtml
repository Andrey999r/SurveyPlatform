@model List<Smth.Data.Survey>
@{
    // Устанавливаем активную вкладку и заголовок страницы для отображения пройденных опросов
    ViewBag.ActiveTab = "Completed";
    ViewBag.Title = "Пройденные опросы";
}

<!-- Начало секции head с определением стилей страницы -->
<head>
    <style>
        /* Определяем основные цвета для оформления страницы */
        :root {
            --primary: #00BFA5;
            --secondary: #009688;
            --background: #1d1d1d;
            --card-bg: #424242;
            --text: #FFFFFF;
            --text-light: #BDBDBD;
        }

        /* Стили для body: фон, цвет текста и шрифт */
        body {
            background: var(--background);
            color: var(--text);
            font-family: 'Segoe UI', sans-serif;
        }

        /* Стили для основного заголовка страницы */
        h2 {
            color: var(--primary);
            margin-bottom: 2rem;
            font-weight: 600;
            text-align: center;
        }

        /* Стили для таблицы опросов */
        .surveys-table {
            width: 100%;
            border-collapse: collapse;
            margin: 2rem 0;
            background: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            animation: fadeIn 0.6s ease-out;
        }

        /* Стили для ячеек таблицы (заголовков и данных) */
        .surveys-table th,
        .surveys-table td {
            padding: 1.2rem;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Стили для заголовков столбцов таблицы */
        .surveys-table th {
            background: rgba(0, 191, 165, 0.1);
            color: var(--primary);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Убираем нижнюю границу у последней строки таблицы */
        .surveys-table tr:last-child td {
            border-bottom: none;
        }

        /* Анимация строк таблицы при наведении курсора */
        .surveys-table tr {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .surveys-table tr:hover {
            background: rgba(255, 255, 255, 0.03);
            transform: translateX(8px);
        }

        /* Стили для ссылки действия (например, кнопка "Ответы") */
        .action-link {
            display: inline-flex;
            align-items: center;
            padding: 0.6rem 1.2rem;
            background: var(--primary);
            color: var(--text) !important;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .action-link:hover {
            background: var(--secondary);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 191, 165, 0.3);
        }

        /* Стили для сообщения об отсутствии опросов */
        .no-surveys {
            text-align: center;
            padding: 3rem;
            color: var(--text-light);
            font-size: 1.1rem;
            animation: fadeIn 0.5s ease;
        }

        /* Стили для пометки опроса, пройденного самостоятельно */
        .self-completed {
            color: var(--primary);
            padding: 0.3rem 0.6rem;
            border-radius: 6px;
            background: rgba(0, 191, 165, 0.1);
        }

        /* Стили для пометки опроса, полученного от другого участника */
        .completed-by-others {
            color: #BDBDBD;
            padding: 0.3rem 0.6rem;
            border-radius: 6px;
            background: rgba(189, 189, 189, 0.1);
        }

        /* Определение анимации появления (fadeIn) */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Медиа-запрос для устройств с маленьким экраном */
        @@media (max-width: 768px) {
            .surveys-table {
                border-radius: 8px;
                margin: 1rem;
            }
            .surveys-table th,
            .surveys-table td {
                padding: 0.8rem;
            }
        }
    </style>
</head>

<!-- Основной заголовок страницы -->
<h2>Пройденные опросы</h2>

<!-- Проверяем, имеются ли опросы в модели -->
@if (!Model.Any())
{
    <!-- Если опросов нет, выводим сообщение -->
    <p class="no-surveys">Вы пока не проходили опросы.</p>
}
else
{
    <!-- Если опросы присутствуют, строим таблицу для их отображения -->
    <table class="surveys-table">
        <thead>
            <tr>
                <!-- Заголовки столбцов таблицы -->
                <th>Название</th>
                <th>Дата прохождения</th>
                <th>Статус</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var survey in Model)
            {
                // Получаем участника опроса, чей email соответствует email текущего пользователя
                var participant = survey.Participants.FirstOrDefault(p => p.Email == ViewBag.UserEmail);
                if (participant != null)
                {
                    // Определяем, прошёл ли опрос пользователь самостоятельно (владелец) или как приглашённый участник
                    bool isSelfCompleted = survey.Owner?.Email == ViewBag.UserEmail;

                    <tr>
                        <!-- Вывод названия опроса -->
                        <td>@survey.Name</td>
                        <!-- Вывод даты прохождения опроса в формате dd.MM.yyyy HH:mm -->
                        <td>@participant.CompletedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (isSelfCompleted)
                            {
                                <!-- Отметка для опроса, пройденного самостоятельно -->
                                <span class="self-completed">Пройден самостоятельно</span>
                            }
                            else
                            {
                                <!-- Отметка для опроса, полученного от приглашения -->
                                <span class="completed-by-others">Полученный опрос</span>
                            }
                        </td>
                        <td>
                            <!-- Ссылка для просмотра деталей прохождения опроса (ответов участника) -->
                            <a href="@Url.Action("InfoSurvey", "Surveys", new { participantId = participant.Id })" class="action-link">
                                <i class="fas fa-eye mr-1"></i> Ответы
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

<!-- Подключаем библиотеку иконок Font Awesome для отображения иконок -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
