@model List<Smth.Data.ApplicationUser>
@{
    ViewBag.Title = "Пользователи";
}

<style>
    :root{
        --primary:#00BFA5; --secondary:#009688; --background:#1d1d1d;
        --card-bg:#2c2c2c; --text:#fff; --text-light:#BDBDBD;
        --border-color:rgba(255,255,255,.1);
    }

    .main-container{max-width:1200px;margin:auto;padding:2rem;animation:fadeIn .6s}
    .page-title   {font-size:2.5rem;color:var(--primary);text-align:center;margin-bottom:2rem;font-weight:700}

    .users-grid   {display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.5rem}

    .user-card{
        background:var(--card-bg);border-radius:12px;padding:1.5rem;position:relative;
        box-shadow:0 4px 6px rgba(0,0,0,.05);transition:.3s}
    .user-card:hover{transform:translateY(-5px);box-shadow:0 8px 12px rgba(0,0,0,.1)}

    .user-name {font-size:1.2rem;font-weight:600;color:var(--text)}
    .user-email{color:var(--text-light);font-size:.9rem;margin:.25rem 0 .5rem}

    .badge       {display:inline-block;padding:.25rem .6rem;border-radius:6px;font-size:.75rem;font-weight:600}
    .badge-admin {background:var(--primary);color:#fff}

    .btn-delete{
        position:absolute;top:1rem;right:1rem;background:transparent;border:none;
        color:#ff7676;cursor:pointer;font-size:1.1rem;transition:.2s}
    .btn-delete:hover{transform:scale(1.1)}

    .btn-view{
        display:inline-block;margin-top:1rem;padding:.5rem 1rem;border-radius:8px;
        background:var(--primary);color:#fff;text-decoration:none;font-weight:500;transition:.3s}
    .btn-view:hover{background:var(--secondary);transform:translateY(-2px)}

    @@keyframes fadeIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
</style>

<div class="main-container">
    <h1 class="page-title"><i class="fas fa-users"></i> Пользователи</h1>

    <div class="users-grid">
    @foreach (var user in Model)
    {
        <div class="user-card">
            <!-- Удаление -->
            <form asp-action="DeleteUser"
                  asp-route-id="@user.Id"
                  method="post"
                  onsubmit="return confirm('Удалить пользователя @user.Username?');">
                @Html.AntiForgeryToken()
                <button type="submit" title="Удалить" class="btn-delete">
                    <i class="fas fa-trash-alt"></i>
                </button>
            </form>

            <div class="user-name">@user.Username</div>
            <div class="user-email">@user.Email</div>

            @* бейдж выводим только если это админ *@
            @if (user.Role == "Admin")
            {
                <span class="badge badge-admin">Admin</span>
            }

            <a asp-action="UserSurveys"
               asp-route-id="@user.Id"
               class="btn-view">
                <i class="fas fa-eye"></i> Опросы
            </a>
        </div>
    }
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;color:var(--text-light);margin-top:3rem">
            <i class="fas fa-user-slash fa-3x"></i>
            <p>Пользователей нет</p>
        </div>
    }
</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
