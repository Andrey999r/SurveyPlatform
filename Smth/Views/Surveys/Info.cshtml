@model Smth.ViewModel.ParticipantViewModel
@{
    ViewData["Title"] = "Информация об участнике";
}

<style>
:root{--primary:#00BFA5;--secondary:#009688;--background:#1d1d1d;
      --card-bg:#2c2c2c;--text:#fff;--text-light:#BDBDBD;
      --border-color:rgba(255,255,255,.1);}

body{background:var(--background);color:var(--text);font-family:'Segoe UI',sans-serif}

h2,h3{color:var(--primary);text-align:center;margin-bottom:2rem;font-weight:600}

.participant-info{background:var(--card-bg);border-radius:12px;padding:2rem;margin-bottom:2rem;
                  box-shadow:0 8px 24px rgba(0,0,0,.2)}

.participant-info p{margin:1rem 0;font-size:1.1rem}

.answers-table{width:100%;border-collapse:collapse;background:var(--card-bg);
               border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.12)}

.answers-table col.question-col{width:40%}
.answers-table col.answer-col  {width:60%}

.answers-table th,.answers-table td{padding:1.1rem 1.3rem;border-bottom:1px solid var(--border-color)}
.answers-table th{background:rgba(0,191,165,.15);color:var(--primary);font-weight:600;text-transform:uppercase}
.answers-table td{vertical-align:top}

.answers-table tr:hover{background:rgba(255,255,255,.025)}

.answers-table input[type="text"]{width:100%;box-sizing:border-box;padding:.6rem 1rem;
                                  background:#202020;border:1px solid var(--border-color);
                                  color:var(--text);border-radius:6px;outline:none}
.answers-table input[type="text"]:focus{border-color:var(--primary);box-shadow:0 0 6px rgba(0,191,165,.4)}

.actions-row{display:flex;gap:1rem;margin-top:1.7rem}

.save-btn,.back-btn{display:inline-flex;align-items:center;gap:.6rem;padding:1rem 2rem;
                    font-weight:600;border-radius:8px;text-decoration:none;transition:.25s}

.save-btn{background:var(--primary);color:#111;border:none;cursor:pointer}
.back-btn{background:transparent;color:var(--primary);border:2px solid var(--primary)}

.back-btn:hover{background:var(--primary);color:#111}
.save-btn:hover{background:var(--secondary)}

.message{padding:1rem;background:rgba(0,191,165,.1);border-radius:8px;color:var(--primary)}

@@media(max-width:768px){
    .answers-table{display:block;overflow-x:auto}
}
</style>

<div class="main-container">
    <h2>Опрос: @Model.SurveyName</h2>

    <div class="participant-info">
        <p><strong>Имя участника:</strong> @Model.ParticipantName</p>
        <p><strong>Email:</strong> @Model.Email</p>
    </div>

    <h3>Ответы:</h3>

    @if (!Model.Answers.Any())
    {
        <div class="message">Ответов не найдено</div>
    }
    else
    {
        <form asp-action="UpdateAnswers" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id"/>

            <table class="answers-table">
                <colgroup>
                    <col class="question-col"/>
                    <col class="answer-col"/>
                </colgroup>
                <thead><tr><th>Вопрос</th><th>Ответ</th></tr></thead>
                <tbody>
                @for (int i = 0; i < Model.Answers.Count; i++)
                {
                    <tr>
                        <td><strong>@Model.Answers[i].Text</strong></td>
                        <td>
                            @if (Model.CanEdit)
                            {
                                <input type="hidden" name="Answers[@i].Id" value="@Model.Answers[i].Id"/>
                                <input type="text"   name="Answers[@i].ResponseText"
                                                     value="@Model.Answers[i].ResponseText"/>
                            }
                            else
                            {
                                @Model.Answers[i].ResponseText
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <div class="actions-row">
                @if (Model.CanEdit)
                {
                    <button type="submit" class="save-btn">
                        <i class="fas fa-save"></i> Сохранить изменения
                    </button>
                }

                <a asp-action="@ViewBag.BackAction"
                   asp-controller="Surveys"
                   asp-route-id="@ViewBag.BackId"
                   class="back-btn">
                    <i class="fas fa-arrow-left"></i> Назад
                </a>
            </div>
        </form>
    }
</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
