@{
    ViewBag.Title = "Создать опрос";
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <style>
        /* Глобальное правило для корректного расчёта размеров */
        * {
            box-sizing: border-box;
        }

        /* Определяем основные цвета через CSS-переменные */
        :root {
            --primary: #00BFA5;
            --secondary: #009688;
            --background: #1d1d1d;
            --card-bg: #424242;
            --text: #FFFFFF;
            --text-light: #BDBDBD;
        }

        /* Стили для body: фон, цвет текста, шрифт и отступы */
        body {
            background: var(--background);
            color: var(--text);
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            padding: 0;
        }

        /* Стили заголовков h2 и h3 с анимацией появления */
        h2,
        h3 {
            color: var(--primary);
            margin-bottom: 1rem;
            font-weight: 600;
            text-align: center;
            animation: fadeIn 0.6s ease-out;
        }

        /* Стили основного контейнера формы создания опроса */
        .create-survey-form {
            max-width: 700px;
            margin: 2rem auto;
            padding: 2rem;
            background: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            animation: fadeIn 0.6s ease-out;
        }

        /* Стили для каждого ряда формы: отступы и расположение по вертикали */
        .form-row {
            margin-bottom: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        /* Стили для полей ввода и текстовых областей */
        .survey-input,
        .survey-textarea,
        .question-input {
            width: 100%;
            padding: 1rem;
            background: #333;
            border: 1px solid #555;
            border-radius: 12px;
            color: var(--text);
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

        /* Стили при фокусе для выделения активного поля */
        .survey-input:focus,
        .survey-textarea:focus,
        .question-input:focus {
            outline: none;
            border-color: var(--primary);
        }

        /* Дополнительные стили для текстовой области: минимальная высота и возможность изменения размера */
        .survey-textarea {
            min-height: 100px;
            resize: vertical;
        }

        /* Стили для ряда вопроса с выравниванием элементов */
        .question-row {
            display: flex;
            gap: 1rem;
            align-items: center;
            margin-bottom: 1rem;
            animation: fadeIn 0.4s ease-out;
        }

        /* Стили кнопки удаления вопроса */
        .remove-question-btn {
            background: transparent;
            color: #ff6666;
            border: none;
            font-size: 1.2rem;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .remove-question-btn:hover {
            transform: scale(1.2);
        }

        /* Стили кнопки добавления нового вопроса */
        .add-question-btn {
            background: var(--primary);
            color: var(--text);
            padding: 0.8rem 1.5rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 500;
        }

        .add-question-btn:hover {
            background: var(--secondary);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 191, 165, 0.3);
        }

        /* Стили для кнопки отправки формы создания опроса */
        .create-button {
            margin-top: 1.5rem;
            width: 100%;
            background: var(--primary);
            color: var(--text);
            padding: 1rem;
            font-size: 1.1rem;
            font-weight: 600;
            border: none;
            border-radius: 12px;
            cursor: pointer;
        }

        .create-button:hover {
            background: var(--secondary);
            transform: scale(1.02);
            box-shadow: 0 4px 14px rgba(0, 191, 165, 0.3);
        }

        /* Анимация появления элементов */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Медиа-запрос для устройств с маленьким экраном */
        @@media (max-width: 768px) {
            .create-survey-form {
                padding: 1.5rem;
            }
        }
    </style>
</head>

<body>
    <!-- Заголовок страницы -->
    <h2>Создать опрос</h2>
    <!-- Форма для создания опроса -->
    <form method="post" class="create-survey-form">
        <!-- Ряд для ввода названия опроса -->
        <div class="form-row">
            <input type="text" name="name" placeholder="Название опроса" class="survey-input" required />
        </div>

        <!-- Ряд для ввода описания опроса -->
        <div class="form-row">
            <textarea name="description" placeholder="Описание" class="survey-textarea" required></textarea>
        </div>

        <!-- Заголовок для раздела вопросов -->
        <h3>Вопросы:</h3>

        <!-- Контейнер для динамически добавляемых вопросов -->
        <div id="questions-container">
            <!-- Первый вопрос с кнопкой удаления -->
            <div class="question-row">
                <input type="text" name="questions" placeholder="Вопрос 1" class="question-input" required />
                <button type="button" class="remove-question-btn" onclick="removeQuestion(this)">✕</button>
            </div>
            <!-- Второй вопрос -->
            <div class="question-row">
                <input type="text" name="questions" placeholder="Вопрос 2" class="question-input" required />
                <button type="button" class="remove-question-btn" onclick="removeQuestion(this)">✕</button>
            </div>
            <!-- Третий вопрос -->
            <div class="question-row">
                <input type="text" name="questions" placeholder="Вопрос 3" class="question-input" required />
                <button type="button" class="remove-question-btn" onclick="removeQuestion(this)">✕</button>
            </div>
        </div>

        <!-- Блок для кнопок действий: добавление нового вопроса и отправка формы -->
        <div class="actions">
            <button type="button" class="add-question-btn" onclick="addQuestion()">+ Добавить вопрос</button>
            <input type="submit" value="Создать" class="create-button" />
        </div>
    </form>

    @section Scripts {
        <script>
            // Функция для добавления нового вопроса
            function addQuestion() {
                // Находим контейнер вопросов
                const container = document.getElementById("questions-container");
                // Определяем текущий номер нового вопроса
                const count = container.querySelectorAll('.question-row').length + 1;
                // Создаем новый div для вопроса
                const row = document.createElement('div');
                row.className = 'question-row';
                // Заполняем HTML новой строки вопроса с динамическим плейсхолдером
                row.innerHTML = `
                        <input type="text" name="questions" placeholder="Вопрос ${count}" class="question-input" required />
                        <button type="button" class="remove-question-btn" onclick="removeQuestion(this)">✕</button>`;
                // Добавляем новую строку в контейнер
                container.appendChild(row);
            }

            // Функция для удаления вопроса
            function removeQuestion(btn) {
                // Находим родительский элемент кнопки (ряд вопроса)
                const row = btn.parentNode;
                const container = document.getElementById("questions-container");
                // Удаляем ряд из контейнера
                container.removeChild(row);
                // Обновляем плейсхолдеры оставшихся вопросов с новым порядковым номером
                const rows = container.querySelectorAll('.question-row');
                rows.forEach((r, i) => {
                    r.querySelector('.question-input').placeholder = 'Вопрос ' + (i + 1);
                });
            }
        </script>
    }
</body>

</html>
