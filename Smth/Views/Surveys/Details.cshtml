@model Smth.ViewModel.SurveyDetailsViewModel
@{
    // Устанавливаем заголовок страницы, равный названию опроса из модели
    ViewBag.Title = Model.Name;
}

<!-- Стили для страницы деталей опроса -->
<style>
    /* Основные переменные для оформления */
    :root {
        --primary: #00BFA5;         /* Основной цвет */
        --secondary: #009688;       /* Вторичный цвет */
        --danger: #dc3545;          /* Цвет для опасных действий (например, удаление) */
        --background: #1d1d1d;       /* Фоновый цвет страницы */
        --card-bg: #2c2c2c;         /* Цвет фона карточек */
        --text: #ffffff;            /* Основной цвет текста */
        --text-light: #BDBDBD;      /* Светлый оттенок для текста */
        --border-color: rgba(255, 255, 255, 0.1); /* Цвет границ элементов */
    }

    /* Основной контейнер страницы с отступами и анимацией появления */
    .main-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        animation: fadeIn 0.6s ease;
    }

    /* Стиль заголовка страницы */
    .page-title {
        font-size: 2.5rem;
        color: var(--primary);
        text-align: center;
        margin-bottom: 2rem;
        font-weight: 700;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        border-bottom: none !important;
        position: relative;
    }

    /* Стиль карточек, используемых для описания опроса и списка участников */
    .card {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
    }

    /* Заголовок секции внутри карточки */
    .section-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.5rem;
        color: var(--text);
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: none !important;
        position: relative;
    }

    /* Таблица для отображения участников */
    .data-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--card-bg);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    /* Заголовок таблицы */
    .data-table-header {
        background: rgba(0, 191, 165, 0.1);
    }

    /* Ряды таблицы с использованием CSS Grid */
    .data-table-row {
        display: grid;
        grid-template-columns: 2fr 3fr 2fr 1fr;
        gap: 1rem;
        padding: 1.2rem;
        align-items: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-bottom: 1px solid var(--border-color);
    }

    /* Эффект при наведении курсора на ряд таблицы */
    .data-table-row:hover {
        background: rgba(255, 255, 255, 0.03);
        transform: translateX(8px);
    }

    /* Ячейки таблицы */
    .data-table-cell {
        padding: 0.8rem;
        font-weight: 500;
    }

    /* Стили для ссылок с акцентом */
    .text-accent {
        color: var(--primary);
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .text-accent:hover {
        color: var(--secondary);
        text-decoration: underline;
    }

    /* Кнопка для удаления участника */
    .btn-danger {
        background: none;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border-radius: 8px;
    }

    .btn-danger:hover {
        background: rgba(220, 53, 69, 0.1);
        transform: scale(1.1);
    }

    /* Иконка мусорной корзины */
    .trash-icon {
        width: 20px;
        height: 20px;
        stroke: var(--danger);
        transition: all 0.3s ease;
    }

    .btn-danger:hover .trash-icon {
        stroke: #bb2d3b;
        animation: shake 0.5s;
    }

    /* Анимация появления контента */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Анимация "дрожания" для иконки при наведении */
    @@keyframes shake {
        0% { transform: translateX(0); }
        25% { transform: translateX(2px); }
        50% { transform: translateX(-2px); }
        75% { transform: translateX(2px); }
        100% { transform: translateX(0); }
    }

    /* Адаптивные стили для устройств с шириной экрана до 768px */
    @@media (max-width: 768px) {
        .data-table-row {
            /* Изменяем схему колонок для удобства просмотра на маленьком экране */
            grid-template-columns: 1fr;
            padding: 1rem;
            gap: 0.5rem;
        }
        .page-title {
            font-size: 2rem;
        }
        .section-title {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }
    }
</style>

<!-- Основной контейнер страницы -->
<div class="main-container">
    <!-- Заголовок страницы, отображающий название опроса -->
    <h1 class="page-title">@Model.Name</h1>

    <!-- Карточка с описанием опроса -->
    <div class="card">
        <div class="section-title">
            <span>Описание опроса</span>
        </div>
        <!-- Отображаем описание опроса, полученное из модели -->
        <p class="text-center">@Model.Description</p>
    </div>

    <!-- Карточка с информацией об участниках -->
    <div class="card">
        <div class="section-title">
            <span>Участники</span>
            <!-- Вывод количества участников с корректным окончанием -->
            <span class="text-light">
                @Model.Participants.Count
                @{
                    var count = Model.Participants.Count;
                    var word = count switch
                    {
                        1 => "участник",
                        > 1 and < 5 => "участника",
                        _ => "участников"
                    };
                }
                @word
            </span>
        </div>

        <!-- Если список участников пуст, выводим сообщение -->
        @if (!Model.Participants.Any())
        {
            <p class="text-center text-light">Пока никто не прошёл опрос</p>
        }
        else
        {
            <!-- Таблица для отображения списка участников -->
            <div class="data-table">
                <!-- Заголовок таблицы -->
                <div class="data-table-header data-table-row">
                    <div class="data-table-cell">Имя</div>
                    <div class="data-table-cell">Email</div>
                    <div class="data-table-cell">Дата</div>
                    <div class="data-table-cell">Действия</div>
                </div>

                <!-- Тело таблицы со списком участников -->
                <div class="data-table-body">
                    @foreach (var p in Model.Participants)
                    {
                        <div class="data-table-row">
                            <!-- Ссылка на подробную информацию об участнике -->
                            <div class="data-table-cell">
                                <a href="@Url.Action("Info", "Surveys", new { participantId = p.Id })" class="text-accent">
                                    @p.ParticipantName
                                </a>
                            </div>
                            <!-- Email участника -->
                            <div class="data-table-cell">@p.Email</div>
                            <!-- Дата прохождения опроса -->
                            <div class="data-table-cell">@p.CompletedAt.ToString("dd.MM.yyyy HH:mm")</div>
                            <!-- Действия: форма для удаления участника -->
                            <div class="data-table-cell">
                                <form method="post" asp-action="DeleteParticipant" asp-controller="Surveys" onsubmit="return confirm('Удалить участника?')">
                                    <input type="hidden" name="participantId" value="@p.Id" />
                                    <button type="submit" class="btn-danger">
                                        <!-- SVG-иконка мусорной корзины -->
                                        <svg class="trash-icon" viewBox="0 0 24 24">
                                            <path d="M6 7V19C6 20.1046 6.89543 21 8 21H16C17.1046 21 18 20.1046 18 19V7M4 7H20M10 11V16M14 11V16M15 7V4C15 3.44772 14.5523 3 14 3H10C9.44772 3 9 3.44772 9 4V7" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
